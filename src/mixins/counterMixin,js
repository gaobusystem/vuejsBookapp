export const counterMixin = {
    data(){
        return {
            count: 0
        }
    },
    computed:{
        doubleCount(){
            return count.value * 2;
        }
    },
    methods:{
        increment(){
            count.value++;
        },
        decrement(){
            count.value--;
        }
    },
    mounted(){
            console.log('Mixin mounted!')
    }
}

